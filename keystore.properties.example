# Copy this file to keystore.properties (gitignored) and fill in your values.
# See RELEASING.md for the keytool command that generates the keystore.

# Path to the upload keystore, RELATIVE to the repo root.
# Convention: keep the .jks outside the repo entirely, or in a directory that
# .gitignore covers (any path ending in .jks / .keystore is ignored).
storeFile=upload-keystore.jks

# Keystore password (set when running keytool).
storePassword=CHANGE_ME

# Key alias inside the keystore (set with -alias when running keytool).
keyAlias=upload

# Key password (set with -keypass when running keytool; often the same as
# storePassword for upload keys).
keyPassword=CHANGE_ME
