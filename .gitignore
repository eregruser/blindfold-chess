# Claude Code metadata — uncomment to share agent/skill config across machines
.claude/

# Stockfish NNUE network files. Large (~108MB combined); fetched separately
# via scripts/fetch_nnue.sh after clone so they don't bloat git history.
engineassets/src/main/assets/*.nnue

# Vosk speech-recognition model. ~68MB extracted; fetched separately by
# scripts/fetch_vosk.sh after clone.
engineassets/src/main/assets/vosk-model-*/

# Release signing secrets. Never commit. See keystore.properties.example for the
# schema and RELEASING.md for the full keystore-creation flow.
keystore.properties
*.jks
*.keystore
